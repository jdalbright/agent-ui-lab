# Live providers (server-only; never expose these with a VITE_ prefix)
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# Generate a unique secret with `openssl rand -base64 32`; never copy a shared placeholder.
# Used for encrypted context tokens and anonymous rate-limit hashing.
CONTEXT_ENCRYPTION_SECRET=

# Required together for a production-wide anonymous rate limit.
# Vercel's managed Upstash integration may provide KV_REST_API_URL and
# KV_REST_API_TOKEN instead; the server accepts either complete pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Exact, comma-separated origins. Include the URL used by `vercel dev` locally.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173,https://lab.jalbright.dev

# Development fixtures must remain disabled in production.
ALLOW_DEMO_FIXTURES=false
